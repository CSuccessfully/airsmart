n; background: rgba(255,255,255,0.1); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.18); }.card-label { font-size: 11px; font-weight: 500; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 12px; opacity: 0.6; color: white; }.card-value { font-family: 'DM Mono', monospace; font-size: 42px; font-weight: 400; line-height: 1; color: white; opacity: 0.4; }.bar-track { height: 3px; background: rgba(255,255,255,0.12); border-radius: 2px; margin-top: 18px; }.bar-fill { height: 100%; border-radius: 2px; background: rgba(255,255,255,0.45); }.circle-deco { position: absolute; border-radius: 50%; border: 1px solid rgba(255,255,255,0.07); }.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }.small-card { background: rgba(255,255,255,0.1); backdrop-filter: blur(16px); border-radius: 16px; padding: 16px; border: 1px solid rgba(255,255,255,0.15); }.small-label { font-size: 10px; color: rgba(255,255,255,0.55); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; font-weight: 500; }.small-val { font-family: 'DM Mono', monospace; font-size: 28px; color: white; font-weight: 400; opacity: 0.3; }.small-unit { font-size: 14px; opacity: 0.55; }.fan-card { background: rgba(0,0,0,0.3); backdrop-filter: blur(16px); border-radius: 18px; padding: 18px 20px; display: flex; align-items: center; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); }.fan-title { font-size: 15px; font-weight: 500; color: white; }.fan-sub { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 3px; }.fan-badge { font-size: 11px; font-weight: 500; padding: 5px 12px; border-radius: 20px; background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.35); border: 1px solid rgba(255,255,255,0.12); }</style></head><body><div class="waves-container"><svg class="wave wave3" viewBox="0 0 1440 400" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="height:80%;"><path d="M0,200 C120,140 240,260 36